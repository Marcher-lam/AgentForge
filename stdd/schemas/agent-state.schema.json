{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-state",
  "title": "AgentState",
  "description": "Agent lifecycle state machine",
  "type": "string",
  "enum": ["created", "initialized", "running", "stopped", "destroyed"],
  "transitions": {
    "created": ["initialized", "destroyed"],
    "initialized": ["running", "destroyed"],
    "running": ["stopped", "destroyed"],
    "stopped": ["running", "destroyed"],
    "destroyed": []
  }
}
